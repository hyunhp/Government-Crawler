# Adjust User and repository paths before installing this unit.
[Unit]
Description=Cleanup crawling logs/data older than 30 days on shutdown

[Service]
Type=oneshot
RemainAfterExit=yes
User=ec2-user
ExecStart=/bin/true
ExecStop=/home/ec2-user/government-rnd-crawler/cleanup_old_files.sh
StandardOutput=append:/home/ec2-user/government-rnd-crawler/logs/shell/cleanup_on_stop.log
StandardError=append:/home/ec2-user/government-rnd-crawler/logs/shell/cleanup_on_stop.log

[Install]
WantedBy=multi-user.target
